// PharmaPong data model.
// Raw-SQL partial unique indexes and CHECK constraints live in the migrations
// (see prisma/migrations/*_constraints and docs/database.md). They are asserted
// by tests/integration/schema-invariants.int.test.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  REFEREE
  ADMIN
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_LOCKED
  GROUP_STAGE
  KNOCKOUT_STAGE
  COMPLETED
  CANCELLED
}

enum TeamStatus {
  ACTIVE
  DISSOLVED
}

enum Stage {
  GROUP
  KNOCKOUT
}

enum MatchStatus {
  PENDING
  READY
  ASSIGNED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  FORFEITED
}

enum EndType {
  REGULAR
  TIME_LIMIT
  SHOOTOUT
  FORFEIT
}

enum Slot {
  HOME
  AWAY
}

// Active game mode of an event (stored on the tournament row, which is the event).
enum GameMode {
  COMPETITIVE
  ELO
}

enum EloSessionStatus {
  OPEN // matches can be created
  PAUSED // no new matches; running ones can finish
  CLOSED // final standings and champion(s) fixed
}

enum EloSide {
  A
  B
}

enum EloResultPolicy {
  DUAL_TEAM_CONFIRMATION
  REFEREE_ONLY
}

enum EloEndType {
  REGULAR
  CONCEDED
}

enum EloConsentMethod {
  CREATOR
  PARTICIPANT
  STAFF
}

// READY (both consents valid) and PAUSED (pausedAt set) are derived states of DRAFT / IN_PROGRESS.
enum EloMatchStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_CONFIRMATION
  DISPUTED
  COMPLETED
  CANCELLED
  VOIDED
}

// ─── Users & auth ──────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique // always stored lowercased + trimmed
  displayName        String
  passwordHash       String
  role               Role     @default(PLAYER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  locale             String? // preferred UI language: en | de | pirate
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions         Session[]
  memberships       TeamMember[]
  passwordResets    PasswordReset[]       @relation("ResetTarget")
  refereeMatches    Match[]               @relation("MatchReferee")
  eloParticipations EloMatchParticipant[]
  eloRatings        EloPlayerRating[]
}

model Session {
  id         String   @id // sha256(token) hex; the raw token only lives in the cookie
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation("ResetTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model AuthThrottle {
  key         String    @id
  count       Int
  windowStart DateTime
  lockedUntil DateTime?
}

// ─── Tournament ────────────────────────────────────────────────────────────

model Tournament {
  id                   String           @id @default(cuid())
  name                 String
  status               TournamentStatus @default(DRAFT)
  isPaused             Boolean          @default(false)
  pausedAt             DateTime?
  publicDisplayEnabled Boolean          @default(false)
  matchDurationSec     Int              @default(900)
  bombRuleEnabled      Boolean          @default(false)
  revision             Int              @default(0) // live-sync cursor, bumped by every mutating tx
  drawGeneratedAt      DateTime?
  rosterLockedAt       DateTime?
  championTeamId       String?
  gameMode             GameMode         @default(COMPETITIVE)
  gameModeChangedAt    DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  teams          Team[]
  members        TeamMember[]
  groups         Group[]
  tables         GameTable[]
  matches        Match[]
  matchEvents    MatchEvent[]
  auditLogs      AuditLog[]
  activeTeamLock ActiveTeamMatch[]
  eloSessions    EloSession[]
}

model Team {
  id             String     @id @default(cuid())
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name           String
  nameNormalized String
  motto          String?
  inviteCode     String     @unique
  status         TeamStatus @default(ACTIVE)
  logoKey        String?
  logoVersion    Int        @default(0)
  createdById    String
  version        Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  members         TeamMember[]
  groupAssignment GroupAssignment?
  homeMatches     Match[]          @relation("HomeTeam")
  awayMatches     Match[]          @relation("AwayTeam")
  wonMatches      Match[]          @relation("WinnerTeam")

  @@unique([tournamentId, nameNormalized])
  @@index([tournamentId, status])
}

model TeamMember {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot         Int // 1 = founder/captain, 2 = partner
  isReady      Boolean    @default(false)
  joinedAt     DateTime   @default(now())
  leftAt       DateTime?

  @@index([teamId])
  @@index([userId])
}

model Group {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String // "A" | "B" | "C" | "D"

  assignments GroupAssignment[]
  matches     Match[]
  tiebreaks   GroupTiebreak[]

  @@unique([tournamentId, name])
}

model GroupAssignment {
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId   String @unique
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position Int // 1..3, draw order

  @@id([groupId, teamId])
  @@unique([groupId, position])
}

// Administrator-recorded ranking shootout for a persistent tie.
model GroupTiebreak {
  id             String    @id @default(cuid())
  groupId        String
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamIds        String[] // sorted tied set
  orderedTeamIds String[] // decided order, best first
  basisHash      String // hash of tie set + their stats; a later correction invalidates it
  recordedById   String
  note           String?
  createdAt      DateTime  @default(now())
  voidedAt       DateTime?

  @@index([groupId])
}

model GameTable {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number       Int
  name         String
  isDisabled   Boolean    @default(false)

  matches    Match[]
  eloMatches EloMatch[]

  @@unique([tournamentId, number])
}

// ─── Matches ───────────────────────────────────────────────────────────────

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  code         String // "A-1".."D-3", "QF1".."QF4", "SF1", "SF2", "F"
  stage        Stage
  round        Int // group: 1..3; knockout: 1=QF 2=SF 3=F
  orderIndex   Int // global play order
  groupId      String?
  group        Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  homeTeamId String?
  homeTeam   Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String?
  awayTeam   Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeSource String? // e.g. "A1", "B2", "W:QF1"
  awaySource String?

  nextMatchId   String?
  nextMatch     Match?  @relation("Advancement", fields: [nextMatchId], references: [id])
  feederMatches Match[] @relation("Advancement")
  nextSlot      Slot?

  status    MatchStatus @default(PENDING)
  tableId   String?
  table     GameTable?  @relation(fields: [tableId], references: [id])
  refereeId String?
  referee   User?       @relation("MatchReferee", fields: [refereeId], references: [id])

  assignedAt       DateTime?
  startedAt        DateTime?
  pausedAt         DateTime?
  pausedDurationMs Int       @default(0)
  endedAt          DateTime?

  // Current (proposed or confirmed) result. Full history lives in AuditLog/MatchEvent.
  winnerTeamId      String?
  winnerTeam        Team?     @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  homeCupsRemaining Int?
  awayCupsRemaining Int?
  endType           EndType?
  resultRevision    Int       @default(0)
  proposedAt        DateTime?
  proposedById      String?
  confirmedAt       DateTime?
  confirmedById     String?

  version   Int      @default(0) // optimistic concurrency
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events MatchEvent[]

  @@unique([tournamentId, code])
  @@unique([tournamentId, orderIndex])
  @@index([tournamentId, status])
  @@index([nextMatchId])
  @@index([tableId])
}

// One row per team while the team is in an ASSIGNED / IN_PROGRESS /
// AWAITING_CONFIRMATION match. The primary key guarantees a team can never be
// in two active matches at once.
model ActiveTeamMatch {
  teamId       String     @id
  matchId      String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([matchId])
}

model MatchEvent {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchId      String
  match        Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type         String // ASSIGNED, STARTED, PAUSED, RESUMED, PROPOSED, REJECTED, CONFIRMED, CORRECTED, VOIDED, FORFEITED, ISSUE_REPORTED, ...
  actorId      String?
  payload      Json?
  createdAt    DateTime   @default(now())

  @@index([matchId, createdAt])
}

// ─── Elo Mode (social apéro) ───────────────────────────────────────────────
// Session-scoped individual ratings for spontaneous matches between temporary teams of 1–4.
// Partial unique indexes and CHECK constraints: prisma/migrations/*_elo_constraints.
// Rating maths: src/server/domain/elo (docs/elo-mode/rating-system.md).

model EloSession {
  id                  String           @id @default(cuid())
  tournamentId        String
  tournament          Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name                String
  status              EloSessionStatus @default(OPEN)
  // Settings that never change existing ratings. Rating parameters live on EloRatingRun.
  minTeamSize         Int              @default(1)
  maxTeamSize         Int              @default(4)
  minGamesForChampion Int              @default(3)
  softReminderMinutes Int?             @default(20) // null = no reminder
  resultPolicy        EloResultPolicy  @default(DUAL_TEAM_CONFIRMATION)
  nextSequence        Int              @default(1) // next confirmation sequence number
  configVersion       Int              @default(0) // optimistic concurrency for settings/status
  championUserIds     String[]         @default([]) // fixed when the session is closed
  createdById         String?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  runs          EloRatingRun[]
  matches       EloMatch[]
  ratings       EloPlayerRating[]
  activePlayers EloActivePlayer[]

  @@index([tournamentId, createdAt])
}

// A calculation run: the rating parameters and every rating change computed with them. A
// correction or parameter change replays the session into a new run; old runs stay as history.
model EloRatingRun {
  id                String     @id @default(cuid())
  sessionId         String
  session           EloSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  revision          Int // 1, 2, …; exactly one run per session has supersededAt = null
  reason            String // INITIAL, CONFIG_CHANGE, CORRECTION, ROSTER_CORRECTION, RATED_CHANGED, VOID, MANUAL
  triggeredById     String?
  note              String?
  algorithmVersion  String
  initialRating     Float
  kFactor           Float
  ratingScale       Float
  repeatMultipliers Float[]
  runtime           String // JavaScript runtime that computed the run (process.version)
  digestAtCreation  String? // projection digest right after the replay
  supersededAt      DateTime?
  createdAt         DateTime   @default(now())

  changes EloRatingChange[]

  @@unique([sessionId, revision])
}

model EloMatch {
  id           String          @id @default(cuid())
  sessionId    String
  session      EloSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tableId      String
  table        GameTable       @relation(fields: [tableId], references: [id])
  status       EloMatchStatus  @default(DRAFT)
  rated        Boolean         @default(true) // false = friendly
  resultPolicy EloResultPolicy // copied from the session at creation
  createdById  String

  // Consent: a side consented to exactly the roster whose hash it stored.
  rosterHash     String
  consentAHash   String?
  consentAById   String?
  consentAAt     DateTime?
  consentAMethod EloConsentMethod?
  consentBHash   String?
  consentBById   String?
  consentBAt     DateTime?
  consentBMethod EloConsentMethod?
  expiresAt      DateTime? // drafts only: cancelled lazily after this

  // Stopwatch (server timestamps)
  startedAt        DateTime?
  pausedAt         DateTime?
  pausedDurationMs Int       @default(0)
  endedAt          DateTime?

  // Current result. Full history: EloMatchResultRevision.
  winnerSide     EloSide?
  endType        EloEndType?
  cupsRemainingA Int?
  cupsRemainingB Int?
  submittedById  String?
  submittedSide  EloSide?
  submittedAt    DateTime?
  confirmedById  String?
  confirmedAt    DateTime?
  disputedById   String?
  disputedAt     DateTime?
  disputeNote    String?
  resultVersion  Int         @default(0)

  // Rating bookkeeping (set at confirmation and by every replay)
  confirmedSequence Int?
  pairKey           String?
  ratingMultiplier  Float?
  expectedScoreA    Float?

  cancelledById String?
  cancelReason  String?
  version       Int      @default(0) // optimistic concurrency
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants  EloMatchParticipant[]
  events        EloMatchEvent[]
  revisions     EloMatchResultRevision[]
  ratingChanges EloRatingChange[]

  @@unique([sessionId, confirmedSequence])
  @@index([sessionId, status])
  @@index([tableId])
}

model EloMatchParticipant {
  id            String   @id @default(cuid())
  matchId       String
  match         EloMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  side          EloSide
  position      Int // 1..4 within the side
  ratingAtStart Float? // informational snapshot at start; never an input of the calculation
  createdAt     DateTime @default(now())

  @@unique([matchId, userId])
  @@unique([matchId, side, position])
  @@index([userId])
}

// One row per player while they are in a DRAFT or IN_PROGRESS Elo match. The primary key
// guarantees a player is never in two live matches at once (mirrors ActiveTeamMatch).
model EloActivePlayer {
  userId    String     @id
  matchId   String
  sessionId String
  session   EloSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([matchId])
}

// Current rating projection of the session's active run (rebuilt by every replay).
model EloPlayerRating {
  id           String     @id @default(cuid())
  sessionId    String
  session      EloSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  rating       Float
  gamesPlayed  Int        @default(0) // effective-rated matches only
  wins         Int        @default(0)
  losses       Int        @default(0)
  lowestRating Float
  peakRating   Float
  lastSequence Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([sessionId, userId])
}

model EloRatingChange {
  id               String       @id @default(cuid())
  runId            String
  run              EloRatingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runRevision      Int
  matchId          String
  match            EloMatch     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId           String
  side             EloSide
  sequence         Int
  ratingBefore     Float
  delta            Float
  ratingAfter      Float
  expectedScore    Float // win probability of the player's side
  teamSize         Int
  opponentTeamSize Int
  multiplier       Float
  algorithmVersion String
  createdAt        DateTime     @default(now())

  @@unique([runId, matchId, userId])
  @@index([runId, userId])
  @@index([matchId])
}

// Immutable history of every result-defining step of a match (never updated).
model EloMatchResultRevision {
  id             String         @id @default(cuid())
  matchId        String
  match          EloMatch       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  revision       Int // equals EloMatch.resultVersion after the step
  kind           String // SUBMITTED, AMENDED, CONFIRMED, DISPUTED, STAFF_FINAL, RESOLVED, CORRECTED, VOIDED, RATED_CHANGED
  status         EloMatchStatus // status after the step
  winnerSide     EloSide?
  rated          Boolean
  endType        EloEndType?
  cupsRemainingA Int?
  cupsRemainingB Int?
  sideA          String[]
  sideB          String[]
  actorId        String?
  reason         String?
  previous       Json? // the replaced values (corrections)
  createdAt      DateTime       @default(now())

  @@unique([matchId, revision])
}

model EloMatchEvent {
  id        String   @id @default(cuid())
  sessionId String
  matchId   String
  match     EloMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      String // CREATED, ROSTER_CHANGED, CONSENTED, LEFT, STARTED, PAUSED, RESUMED, RESULT_SUBMITTED, …, CANCELLED, EXPIRED
  actorId   String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
  @@index([sessionId, createdAt])
}

// ─── Infrastructure ────────────────────────────────────────────────────────

model IdempotencyKey {
  key         String   @id
  userId      String
  scope       String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id           BigInt      @id @default(autoincrement())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  actorId      String?
  action       String
  entityType   String
  entityId     String
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([tournamentId, createdAt])
}
