# Local development (docker compose up -d)
DATABASE_URL="postgresql://pharmapong:pharmapong@localhost:54329/pharmapong_dev"
DATABASE_URL_TEST="postgresql://pharmapong:pharmapong@localhost:54329/pharmapong_test"
DATABASE_URL_E2E="postgresql://pharmapong:pharmapong@localhost:54329/pharmapong_e2e"

# Public base URL of the app (used for invite links and Origin checks)
APP_URL="http://localhost:3000"

# Initial administrator (created by scripts/seed-admin.ts only if missing)
ADMIN_EMAIL="admin@pharmapong.local"
ADMIN_INITIAL_PASSWORD="change-me-please-123"

# Optional: require this code at registration (leave empty to disable)
EVENT_CODE=""

# Object storage: "memory" (dev/tests) or "s3"
STORAGE_DRIVER="memory"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
